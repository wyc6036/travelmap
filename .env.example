# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略，不会提交）

# MinIO 媒体落盘目录：相对 docker-compose.yml 的路径，或绝对路径。
# 留空则默认 ./minio-data（项目内的真实文件夹，Finder 可直接查看/备份）。
MINIO_DATA_DIR=./minio-data

# 应用数据目录（SQLite 库 + 上传媒体缩略图）：相对/绝对路径。
# 留空则默认 ./data（项目内的真实文件夹，Finder 可直接查看/备份）。
APP_DATA_DIR=./data

# ===== 发布 / 部署版（docker-compose.prod.yml）需要 =====
# 你的 Docker Hub 用户名（决定镜像路径 docker.io/<DH_USER>/travelmap）
DH_USER=your-dockerhub-username

# 访问密码（必填，部署机必需）。请改成强密码。
ADMIN_PASSWORD=change-me-please

# 会话签名密钥（可选；留空则每次容器重启随机生成，已登录会话会失效需重登）
SESSION_SECRET=
